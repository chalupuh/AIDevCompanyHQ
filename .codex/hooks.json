{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/goldg/AI Development Company/.studio/studio.js\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/goldg/AI Development Company/.studio/studio.js\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/goldg/AI Development Company/.studio/studio.js\" hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
